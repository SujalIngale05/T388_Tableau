      <aliases enabled='yes' />
      <column datatype='integer' hidden='true' name='[Beds]' role='measure' type='quantitative' />
      <column caption='Review Performance Score' datatype='integer' name='[Calculation_0181204710981633]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Number of Records]*[Review Scores Rating]' />
      </column>
      <column caption='Price Category' datatype='string' name='[Calculation_0181204712767490]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt;300 THEN &quot;Luxury&quot;&#13;&#10;ELSEIF [Price]&gt;150 THEN &quot;Standard&quot;&#13;&#10;ELSE &quot;Budget&quot;&#13;&#10;END' />
      </column>
      <column caption='Count Of Hotels' datatype='integer' name='[Calculation_0181204715667459]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Name])' />
      </column>
      <column caption='Host Status' datatype='string' name='[Calculation_0181204719607812]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Host Since] &lt; TODAY()THEN &quot;Active Host&quot;&#13;&#10;ELSE &quot;New Host&quot;&#13;&#10;END' />
      </column>
      <column caption='Review Category' datatype='string' name='[Calculation_0181204720390149]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Number Of Reviews]&gt;=100 THEN &quot;Highly Review&quot;&#13;&#10;ELSE &quot;Less Review&quot;&#13;&#10;END' />
      </column>
      <column caption='Price Filter Category' datatype='string' name='[Calculation_0181204722249735]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt; [Parameters].[Parameter 0181204721225734]&#13;&#10;THEN &quot;Above Limit&quot;&#13;&#10;ELSE &quot;Below Limit&quot;&#13;&#10;END' />
      </column>
      <column caption='New Host Since' datatype='date' name='[Calculation_0181204729950218]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL(([Host Since]), DATE(&quot;01-01-2010&quot;))' />
      </column>
      <column caption='Review Scores Rating (Bin)' datatype='string' name='[Calculation_0181204731514891]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL((STR([Review Scores Rating (bin)])),&quot;Not Rated&quot;)' />
      </column>
      <column caption='Updated Beds' datatype='integer' name='[Calculation_0181204732440589]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Beds],0)' />
      </column>
      <column datatype='integer' name='[Host Id]' role='dimension' type='ordinal' />
      <column datatype='date' hidden='true' name='[Host Since]' role='dimension' type='ordinal' />
      <column datatype='integer' hidden='true' name='[Review Scores Rating (bin)]' role='measure' type='quantitative' />
      <column aggregation='Sum' datatype='integer' default-format='*00000' name='[Zipcode]' role='dimension' semantic-role='[ZipCode].[Name]' type='ordinal' />
